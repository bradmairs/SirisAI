SIRISAI_APP_NAME=SirisAI
SIRISAI_ENVIRONMENT=development
SIRISAI_LOG_LEVEL=INFO

SIRISAI_HOST=0.0.0.0
SIRISAI_PORT=8000

SIRISAI_DATABASE_URL=sqlite:///./data/sirisai.db

# Model-agnostic LLM settings.
SIRISAI_LLM_PROVIDER=none
SIRISAI_OLLAMA_BASE_URL=http://localhost:11434
SIRISAI_OLLAMA_MODEL=llama3

# Semantic memory recall (app/llm/embeddings.py). "none" (default) keeps
# the `recall` tool on a plain substring match -- a paraphrased query that
# doesn't share literal words with the saved memory just won't find it.
# "ollama" turns on real semantic search: reuses SIRISAI_OLLAMA_BASE_URL
# above (embeddings and chat are almost always the same Ollama instance)
# with a separate, much smaller model -- `ollama pull nomic-embed-text`
# on that Ollama host first, it's not a chat model and won't already be
# pulled. Also enables a write-time dedup safety net in the `remember`
# tool: a near-duplicate of something already saved isn't re-stored.
SIRISAI_EMBEDDING_PROVIDER=none
SIRISAI_EMBEDDING_MODEL=nomic-embed-text

# Speech settings. "openai_compatible" works with any local server that
# speaks OpenAI's audio API shape. speaches (https://speaches.ai,
# ghcr.io/speaches-ai/speaches:latest-cpu) is the one this project's own
# server runs -- a single CPU-only container providing both endpoints
# below (faster-whisper for STT, Kokoro for TTS), so it never competes
# with Ollama for GPU. Point both _BASE_URL settings at it; download its
# models once with (run inside the speaches container, or anywhere with
# `uv` and SPEACHES_BASE_URL set to it):
#   uv tool run speaches-cli model download Systran/faster-distil-whisper-small.en
#   uv tool run speaches-cli model download speaches-ai/Kokoro-82M-v1.0-ONNX
SIRISAI_STT_PROVIDER=none
SIRISAI_STT_BASE_URL=http://localhost:8081
SIRISAI_STT_MODEL=whisper-1
# SIRISAI_STT_MODEL=Systran/faster-distil-whisper-small.en

SIRISAI_TTS_PROVIDER=none
SIRISAI_TTS_BASE_URL=http://localhost:8082
SIRISAI_TTS_MODEL=tts-1
SIRISAI_TTS_VOICE=default
# SIRISAI_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# SIRISAI_TTS_VOICE=af_heart -- other Kokoro voices: af_bella, am_adam, bf_emma, bm_george, ...
# Speaking pace, 1.0 = natural.
# SIRISAI_TTS_SPEED=1.1
# Optional ffmpeg filter chain over every spoken clip; empty = off. A
# "lightly electronic" (Jarvis-ish) comb + flanger, loudness-compensated:
# SIRISAI_TTS_EFFECT=aecho=0.8:0.8:6|11:0.4|0.25,flanger=delay=2:depth=2:regen=10:width=60:speed=0.4,highpass=f=120,lowpass=f=9000,volume=8dB

# Model router (app/llm/router.py): an optional second, faster/smaller
# model for short/simple prompts, alongside the default ("general") one
# configured above. Leave SIRISAI_FAST_LLM_PROVIDER=none to leave it off
# (the default -- every chat call uses the general model, same as before
# this existed). "off" policy always uses general even if a fast model is
# configured; "prompt_length" auto-routes prompts at or under the given
# character count to it. Either way, a chat request can force a role
# directly with "model_role": "fast".
SIRISAI_MODEL_ROUTER_POLICY=off
SIRISAI_MODEL_ROUTER_FAST_MAX_PROMPT_CHARS=120
SIRISAI_FAST_LLM_PROVIDER=none
SIRISAI_FAST_LLM_OLLAMA_BASE_URL=http://localhost:11434
SIRISAI_FAST_LLM_OLLAMA_MODEL=llama3.2:1b

# Home Assistant. Both must be set for the home_assistant_* tools to be
# registered -- leave either blank to leave them off. Create a long-lived
# access token in Home Assistant under your profile -> Security ->
# Long-Lived Access Tokens.
SIRISAI_HOME_ASSISTANT_BASE_URL=
SIRISAI_HOME_ASSISTANT_TOKEN=

# home_assistant_call_service is CONFIRM_REQUIRED by default -- it can
# call *any* Home Assistant service, including ones with real physical
# consequences (unlocking a door, disarming an alarm), so SirisAI asks
# before running it. Comma-separated list of domains that should skip
# that confirmation and run immediately instead -- e.g. lights/switches
# you're happy to have controlled without asking each time. Everything
# NOT listed still requires confirmation. Empty (default) = every call
# still requires confirmation, unchanged. A single "*" means every
# domain EXCEPT lock and cover (garage doors are a `cover` entity in
# Home Assistant) -- those two always require confirmation regardless
# of this setting, not configurable.
# SIRISAI_HOME_ASSISTANT_NO_CONFIRM_DOMAINS=light,switch,fan,media_player
# SIRISAI_HOME_ASSISTANT_NO_CONFIRM_DOMAINS=*
SIRISAI_HOME_ASSISTANT_NO_CONFIRM_DOMAINS=

# Cost/resource dashboard (milestone 47, GET /siris/metrics/dashboard):
# LLM token spend is always tracked once an LLM backend is configured
# above, no setting needed. Homelab power draw has no sensor of its own
# in this codebase, so it reads a Home Assistant entity's state as a
# wattage reading instead (e.g. a smart plug/PDU sensor) -- requires
# SIRISAI_HOME_ASSISTANT_BASE_URL/TOKEN above to also be set. Empty
# (default) = power draw isn't tracked.
SIRISAI_POWER_SENSOR_ENTITY_ID=

# System info tool (CPU/memory/disk/temperature) -- always on, no
# credentials needed. Comma-separated mount paths to report disk usage
# for; "/" alone reflects this container's own filesystem unless you've
# bind-mounted host paths in. Add more (e.g. "/,/mnt/nas") as needed.
SIRISAI_SYSTEM_INFO_DISK_PATHS=/

# Docker. Set to enable docker_list_containers/docker_restart_container.
# Point at a Unix socket -- mount the host's /var/run/docker.sock into
# this container read-write in docker-compose.yml -- or a TCP-exposed
# daemon (e.g. tcp://192.168.1.10:2375). Leave blank to leave these off.
SIRISAI_DOCKER_BASE_URL=

# Plex. Both must be set for the plex_* tools to be registered. Find your
# token at https://support.plex.tv/articles/204059436.
SIRISAI_PLEX_BASE_URL=http://localhost:32400
SIRISAI_PLEX_TOKEN=

# UniFi. Both must be set for the unifi_* tools to be registered. Uses
# the local controller's own "Integration API", not UniFi's cloud
# account API (a different key/product -- a cloud key 401'd against the
# local path when first tried). Generate the key from the controller's
# own UI at its LAN IP -> Settings -> Control Plane -> Integrations ->
# Create API Key. SIRISAI_UNIFI_BASE_URL is that same LAN IP, e.g.
# https://192.168.1.1 (live-verified 2026-09 against a Cloud Gateway
# Ultra -- both unifi_list_devices and unifi_list_clients work this way,
# unlike the cloud API which has no client-listing endpoint at all).
# SIRISAI_UNIFI_SITE is the site's human-readable name/reference (the
# default "default" is right for a single-site home network); resolved
# to the real site id the Integration API actually needs automatically.
SIRISAI_UNIFI_BASE_URL=
SIRISAI_UNIFI_API_KEY=
SIRISAI_UNIFI_SITE=default
SIRISAI_UNIFI_VERIFY_SSL=false

# Weather, via Open-Meteo -- free, no API key. Both lat/long must be set
# for the weather_current tool to be registered.
SIRISAI_WEATHER_LATITUDE=
SIRISAI_WEATHER_LONGITUDE=

# Calendars. Everything set here is merged into one calendar for chat, the
# HUD, briefings and SirisOS (see README "Connecting your calendars").
#
# iCloud (or Nextcloud, Radicale, Baikal...) over CalDAV. For iCloud:
#   URL https://caldav.icloud.com, your Apple ID email, and an
#   app-specific password from account.apple.com -> Sign-In and Security.
# This is also where new events are created.
SIRISAI_CALDAV_URL=
SIRISAI_CALDAV_USERNAME=
SIRISAI_CALDAV_PASSWORD=
# Gmail / Google Calendar: each calendar's "Secret address in iCal format"
# (calendar.google.com -> Settings -> the calendar -> Integrate calendar).
# One per line or comma, each "Label|URL". Read-only; keep it secret.
SIRISAI_CALENDAR_ICS_URLS=
# Calendar names to leave out everywhere, e.g. Birthdays,Holidays in Australia
SIRISAI_CALENDAR_EXCLUDE=
# Home Assistant calendars to skip (media schedules aren't your day; the
# sonarr_/radarr_calendar tools still answer "what's on TV this week").
SIRISAI_HOME_ASSISTANT_CALENDAR_EXCLUDE=sonarr,radarr,lidarr,readarr

# Proactive notifications via ntfy.sh (https://ntfy.sh/docs/) -- no
# account needed, just a topic name (treat it like a secret: anyone who
# knows it can read your notifications on the public service, or
# self-host your own ntfy instance and point SIRISAI_NTFY_BASE_URL at
# it). Set the topic to enable the notify tool and let
# POST /siris/proactive/check actually send something when it finds a
# problem; leave it blank and that endpoint still runs the health check,
# it just never notifies. Example crontab entry to check every 15
# minutes: */15 * * * * curl -s -X POST -H "Authorization: Bearer
# $SIRISAI_API_KEY" http://localhost:8000/siris/proactive/check
SIRISAI_NTFY_BASE_URL=https://ntfy.sh
SIRISAI_NTFY_TOPIC=

# Actionable push notifications (milestone 43): the externally-reachable
# base URL this instance is served at (behind a reverse proxy, a
# Cloudflare tunnel, Tailscale, etc). Needed only to build the "Confirm"
# action button ntfy attaches when a routine's action needs confirmation
# -- the button has to point somewhere your phone can actually reach, not
# necessarily http://localhost:8000. Leave blank and those notifications
# still get sent, just without a one-tap action.
SIRISAI_PUBLIC_BASE_URL=

# The HTTPS front end (docker compose --profile https, caddy/Caddyfile).
# When set, opening the web pages (/, /hud, /brain) over plain http
# redirects here, because browsers only allow the mic on https. The API
# stays on http. Blank = no redirect.
# SIRISAI_HTTPS_REDIRECT_URL=https://192.168.0.100:8443

# Persona/voice consistency layer (milestone 45): a system message
# applied to every chat turn, ahead of context -- how SirisAI talks, not
# what it currently knows. Blank (default) = no persona message at all,
# just the raw model's own default tone. Uncomment and adjust to taste:
# SIRISAI_PERSONA=You are SirisAI, a self-hosted homelab assistant. Be concise and direct; dry wit is welcome, sycophancy is not. You have real tools and act on this user's actual infrastructure, so be precise about what you know versus what you're inferring.
SIRISAI_PERSONA=

# Hermes Agent -- a separate homelab agent running on this same host, with
# its own memories, skills, and terminal access, used here to delegate
# Docker container control and other system-level tasks it already knows
# how to do. Talks an OpenAI-style chat completions endpoint
# (POST {base_url}/v1/chat/completions). Leave the base_url blank to
# leave the hermes_run_task tool unregistered. Some Hermes deployments
# are unauthenticated -- leave hermes_api_key blank for those; others
# need `Authorization: Bearer <key>`, set it if yours 401s without one.
SIRISAI_HERMES_BASE_URL=
SIRISAI_HERMES_MODEL=hermes
SIRISAI_HERMES_API_KEY=
# How long to wait for a delegated task, in seconds -- Hermes may do its
# own multi-step tool use/terminal work before responding. Raise this if
# your heaviest delegated tasks take longer than the default.
SIRISAI_HERMES_TIMEOUT_SECONDS=120

# Automatic memory extraction: after each chat turn, a separate LLM pass
# reviews the exchange and decides on its own whether to save anything to
# long-term memory -- on by default. Set to false to turn off the extra
# LLM call entirely (the existing remember/recall tools stay available to
# the model either way, this only controls the automatic pass).
SIRISAI_AUTO_MEMORY_EXTRACTION_ENABLED=true

# Tautulli -- Plex activity/history companion, not a replacement for Plex
# itself (SIRISAI_PLEX_* above). Both must be set to enable the
# tautulli_* tools. Generate an API key under Tautulli's Settings ->
# Web Interface -> API.
SIRISAI_TAUTULLI_BASE_URL=
SIRISAI_TAUTULLI_API_KEY=

# Radarr -- movie collection manager. Both must be set to enable the
# radarr_* tools. Generate an API key under Radarr's Settings ->
# General -> Security.
SIRISAI_RADARR_BASE_URL=
SIRISAI_RADARR_API_KEY=

# Sonarr -- TV collection manager, same API shape as Radarr. Both must
# be set to enable the sonarr_* tools. Generate an API key under
# Sonarr's Settings -> General -> Security.
SIRISAI_SONARR_BASE_URL=
SIRISAI_SONARR_API_KEY=

# Bazarr -- subtitle manager for Radarr/Sonarr libraries. Both must be
# set to enable the bazarr_* tools. Generate an API key under Bazarr's
# Settings -> General.
SIRISAI_BAZARR_BASE_URL=
SIRISAI_BAZARR_API_KEY=

# Listenarr -- audiobook/podcast manager. The least-confidently-verified
# integration in this codebase (see app/listenarr/client.py's docstring)
# -- built from the shared Servarr-family API convention without a live
# instance to confirm Listenarr's own resource model against, so only
# system/status and queue are implemented. Both must be set to enable
# the listenarr_* tools.
SIRISAI_LISTENARR_BASE_URL=
SIRISAI_LISTENARR_API_KEY=

# Cleanuparr -- stalled/failed download cleanup for *arr apps + download
# clients. Even less confidently verified than Listenarr (see
# app/cleanuparr/client.py's docstring) -- limited to a status check;
# consider POST /siris/integrations (milestone 32's OpenAPI discovery)
# for the rest once you can point it at a real instance/spec. Both must
# be set to enable the cleanuparr_status tool.
SIRISAI_CLEANUPARR_BASE_URL=
SIRISAI_CLEANUPARR_API_KEY=

# Obsidian, via the community "Local REST API" plugin
# (https://github.com/coddingtonbear/obsidian-local-rest-api) -- not
# Obsidian itself, which has no API of its own. Defaults match the
# plugin's own defaults (HTTPS on 27124, self-signed certificate, hence
# VERIFY_SSL=false). Both base_url and api_key must be set to enable
# the obsidian_* tools; the plugin shows the API key in its own
# settings pane once installed.
SIRISAI_OBSIDIAN_BASE_URL=https://127.0.0.1:27124
SIRISAI_OBSIDIAN_API_KEY=
SIRISAI_OBSIDIAN_VERIFY_SSL=false

# Second brain -- a local checkout of Siris-Second-Brain
# (https://github.com/bradmairs/Siris-Second-Brain). Clone it inside ./data
# so it's in the mounted volume:
#   git clone git@github.com:bradmairs/Siris-Second-Brain.git data/second-brain
# then set BRAIN_PATH to the in-container path. Enables brain_search,
# brain_get_note and brain_learn, and (with MIRROR_MEMORY) copies
# `remember`/`remember_entity_fact` facts into the vault. GIT_SYNC pulls
# before reads and commits + pushes after writes -- the SSH key in
# ./data/ssh needs write access to the repo (a GitHub deploy key works).
SIRISAI_BRAIN_PATH=
SIRISAI_BRAIN_GIT_SYNC=false
SIRISAI_BRAIN_PULL_INTERVAL_SECONDS=60
SIRISAI_BRAIN_MIRROR_MEMORY=true
# Notes matching each chat message added as background context (0 = off).
SIRISAI_BRAIN_CONTEXT_NOTES=3
# Growth jobs, local time. Leave an hour empty to turn that job off.
SIRISAI_BRAIN_MEETING_NOTES_HOUR_LOCAL=6
# Meeting notes are opt-in: name the calendars whose timed events should get a
# note in the brain (e.g. Work). Empty = none, so personal events (a haircut,
# "Call dad") are never written into the brain.
SIRISAI_BRAIN_MEETING_CALENDARS=
SIRISAI_BRAIN_DREAM_HOUR_LOCAL=23
# 0=Monday ... 6=Sunday: gap questions, health snapshot, home lab log.
SIRISAI_BRAIN_WEEKLY_DAY=6
SIRISAI_BRAIN_WEEKLY_HOUR_LOCAL=18
SIRISAI_BRAIN_GAP_QUESTIONS=3
# Notes Siris wrote that it asks you to check each week (0 = off).
SIRISAI_BRAIN_REVIEW_NOTES=3
# Nightly upkeep with the local model: file the inbox, add the day's GitHub
# activity to project notes, relink, and (on WEEKLY_DAY) a weekly review.
# The token only reads: a fine-grained one with Contents, Pull requests and
# Metadata read access. Empty skips the GitHub step.
SIRISAI_BRAIN_UPKEEP_HOUR_LOCAL=2
SIRISAI_BRAIN_GITHUB_TOKEN=
SIRISAI_BRAIN_GITHUB_OWNER=bradmairs

# Frigate (https://frigate.video/) -- self-hosted NVR with local object
# detection; SirisAI's first vision integration (camera list, recent
# detection events). Only base_url is required -- a typical self-hosted
# Frigate instance has no built-in API auth, so api_key is optional
# (sent as a bearer token when set, for setups that front it with one).
SIRISAI_FRIGATE_BASE_URL=
SIRISAI_FRIGATE_API_KEY=

# Synology NAS (app/synology/, app/plugins/builtin/synology.py) -- DSM
# Web API for system status, storage health, disk SMART, and backup tasks.
# Uses session-based auth (SYNO.API.Auth) with a local DSM user account.
# All three must be set for the synology_get_status tool to be registered.
# Create a DSM user with read-only access to the relevant APIs if desired.
# Verify SSL can be false for self-signed certs on self-hosted DSM.
SIRISAI_SYNOLOGY_BASE_URL=
SIRISAI_SYNOLOGY_USERNAME=
SIRISAI_SYNOLOGY_PASSWORD=
SIRISAI_SYNOLOGY_VERIFY_SSL=true

# Cron job overview (app/cron/, the Cron tab) -- read and toggle crontabs
# on other machines over plain `ssh`. Comma-separated user@host (or
# user@host:port). Empty (default) = feature off. The SirisAI container
# needs its own SSH key: generate one in the data dir that docker-compose
# mounts as /root/.ssh, then add the public key to each host's
# authorized_keys (for Home Assistant OS, the SSH add-on's config):
#   mkdir -p data/ssh && ssh-keygen -t ed25519 -N "" -C sirisai-cron -f data/ssh/id_ed25519
#   cat data/ssh/id_ed25519.pub   # append to ~/.ssh/authorized_keys on each host
# Host keys are trusted on first use (StrictHostKeyChecking=accept-new).
# SIRISAI_CRON_HOSTS=brad@192.168.0.127,root@192.168.0.83
SIRISAI_CRON_HOSTS=

# Timezone for dates and times (an IANA name). The model has no clock of its
# own: this is what "today", "tonight" and reminder times are worked out in,
# and what event times are shown in.
SIRISAI_TIMEZONE=UTC
# e.g. SIRISAI_TIMEZONE=Australia/Melbourne

# Multi-step chat (plan -> act -> plan -> answer). On by default; a single
# tool per turn got two-step requests ("turn on the light at 40%") wrong.
# SIRISAI_DEFAULT_USE_PLANNER=true

# Offer the model only the most relevant tools each turn instead of every
# tool (about 13k prompt tokens -> 1-5k). 0 = offer everything.
# SIRISAI_TOOL_SELECTION_MAX=32

# Background scheduler: delivers due reminders/timers as push notifications,
# alerts when a tool has been failing, and runs the proactive checks below
# on their own schedule instead of needing an external cron job. On by
# default.
# SIRISAI_SCHEDULER_ENABLED=true

# Proactive checks (POST /siris/proactive/*, app/notify/proactive.py), run
# automatically by the background scheduler. 0 disables a given check.
# The health check (server/event/goal/new-device warnings, scored and
# correlated -- see app/notify/manager.py) and the once-daily briefing.
# SIRISAI_PROACTIVE_CHECK_INTERVAL_MINUTES=30
# Local hour (0-23, in SIRISAI_TIMEZONE) the daily briefing goes out.
# Leave unset (default) to disable it.
# SIRISAI_BRIEFING_HOUR_LOCAL=7
# Presence and geofence-reminder checks (both "did a zone transition
# happen") -- a shorter interval than the health check, since a transition
# is worth catching quickly. No-ops when neither is configured.
# SIRISAI_PRESENCE_CHECK_INTERVAL_MINUTES=3

# Read-only web search and page fetch. Uses DuckDuckGo unless a SearXNG
# instance is given; fetching only reaches the public internet.
# SIRISAI_WEB_TOOLS_ENABLED=true
# SIRISAI_WEB_SEARCH_URL=http://searxng.lan:8080

# Routines (app/routines/) -- no settings of their own, but like
# /siris/proactive/check above, POST /siris/routines/run_due needs an
# external trigger to actually run due routines; SirisAI only decides
# what's due when asked. Example crontab entry to check every 5 minutes
# (frequent enough to catch a routine with interval_minutes=5 or higher):
# */5 * * * * curl -s -X POST -H "Authorization: Bearer $SIRISAI_API_KEY"
# http://localhost:8000/siris/routines/run_due

# Weather for the briefing (Open-Meteo, no key). Off until a location is set.
# SIRISAI_WEATHER_LATITUDE=-37.81
# SIRISAI_WEATHER_LONGITUDE=144.96
# SIRISAI_WEATHER_BASE_URL=https://api.open-meteo.com

# Background scheduler tick (proactive checks, routines, deferred jobs).
# SIRISAI_SCHEDULER_INTERVAL_SECONDS=20

# Presence: UniFi device names that mean "someone is home", and optional
# Home Assistant scenes to activate on arrival/departure.
# SIRISAI_PRESENCE_DEVICE_NAMES=alice-phone,bob-phone
# SIRISAI_PRESENCE_HOME_SCENE=scene.welcome_home
# SIRISAI_PRESENCE_AWAY_SCENE=scene.away
# How far ahead a calendar event counts as "coming up" when you leave.
# SIRISAI_DEPARTURE_EVENT_WINDOW_HOURS=3

# Voice: confirm actions by saying "yes"/"no". Domains listed here are
# never confirmable by voice except securing actions (lock, close, arm).
# SIRISAI_VOICE_CONFIRMATION_ENABLED=true
# SIRISAI_VOICE_CONFIRMATION_BLOCKED_DOMAINS=lock,cover,alarm_control_panel
# Window for a satellite to hand a follow-up back to the same conversation.
# SIRISAI_SATELLITE_HANDOFF_WINDOW_SECONDS=120
# Speaker identification (fetch weights with scripts/fetch_voice_encoder.py;
# the Docker image already includes them).
# SIRISAI_SPEAKER_ID_MODEL_PATH=models/voice_encoder.npz
# SIRISAI_SPEAKER_ID_THRESHOLD=0.80

# Vision: an Ollama vision model for camera snapshots and chat photos.
# Empty = off. The base URL defaults to SIRISAI_OLLAMA_BASE_URL.
# SIRISAI_VISION_MODEL=llava:7b
# SIRISAI_VISION_BASE_URL=

# Protocols, night and guest mode.
# SIRISAI_NIGHT_START_HOUR=22
# SIRISAI_NIGHT_END_HOUR=6
# SIRISAI_GUEST_WIFI_ENTITY_ID=switch.guest_wifi
# Intruder response (needs Frigate): away | night | away_or_night.
# SIRISAI_INTRUDER_CHECK_INTERVAL_MINUTES=1
# SIRISAI_INTRUDER_ALERT_WHEN=away_or_night
# SIRISAI_INTRUDER_CAMERAS=front_door,driveway
# SIRISAI_INTRUDER_COOLDOWN_MINUTES=10
# SIRISAI_INTRUDER_AUTO_LOCKDOWN=false

# Self-healing: containers SirisAI may restart without asking ("*" = all).
# Empty = off. Past the caps you get an urgent push with logs instead.
# SIRISAI_REMEDIATION_CONTAINERS=frigate,mosquitto
# SIRISAI_REMEDIATION_CHECK_INTERVAL_MINUTES=5
# SIRISAI_REMEDIATION_MAX_RESTARTS_PER_CONTAINER=2
# SIRISAI_REMEDIATION_MAX_ACTIONS_PER_HOUR=4
# SIRISAI_REMEDIATION_SETTLE_SECONDS=8

# Security watch: certificates ("host" or "host:port"), SSH failed logins,
# UniFi IPS, Synology backups, and a weekly Trivy scan if trivy is installed.
# SIRISAI_SECURITY_CERT_HOSTS=nas.lan:5001,home.example.com
# SIRISAI_SECURITY_CERT_WARN_DAYS=14
# SIRISAI_SECURITY_SSH_FAILED_THRESHOLD=25
# SIRISAI_SECURITY_CHECK_INTERVAL_HOURS=6
# SIRISAI_SECURITY_SCAN_INTERVAL_DAYS=7
# SIRISAI_BACKUP_MAX_AGE_HOURS=26

# Habits mined from the Home Assistant logbook (suggested as automations).
# SIRISAI_HABIT_LOOKBACK_DAYS=14
# SIRISAI_HABIT_MIN_DAYS=5
# SIRISAI_HABIT_CHECK_INTERVAL_DAYS=7

# Energy-aware scheduling: cheap windows (local HH:MM-HH:MM, comma-separated),
# solar surplus, or a price sensor.
# SIRISAI_ENERGY_CHEAP_WINDOWS=00:00-06:00,11:00-14:00
# SIRISAI_ENERGY_SOLAR_ENTITY_ID=sensor.solar_power
# SIRISAI_ENERGY_SOLAR_MIN_WATTS=1500
# SIRISAI_ENERGY_PRICE_ENTITY_ID=sensor.electricity_price
# SIRISAI_ENERGY_PRICE_MAX=0.15

# Email over IMAP/SMTP. Sending always asks for confirmation.
# SIRISAI_EMAIL_IMAP_HOST=imap.fastmail.com
# SIRISAI_EMAIL_IMAP_PORT=993
# SIRISAI_EMAIL_USE_SSL=true
# SIRISAI_EMAIL_USERNAME=
# SIRISAI_EMAIL_PASSWORD=
# SIRISAI_EMAIL_SMTP_HOST=smtp.fastmail.com
# SIRISAI_EMAIL_SMTP_PORT=587
# SIRISAI_EMAIL_FROM=
# SIRISAI_EMAIL_DRAFTS_FOLDER=Drafts

# Car, via its Home Assistant integration (each entity optional).
# SIRISAI_CAR_NAME=the car
# SIRISAI_CAR_BATTERY_ENTITY_ID=sensor.car_battery
# SIRISAI_CAR_RANGE_ENTITY_ID=sensor.car_range
# SIRISAI_CAR_CHARGING_ENTITY_ID=binary_sensor.car_charging
# SIRISAI_CAR_PLUGGED_ENTITY_ID=binary_sensor.car_plugged_in
# SIRISAI_CAR_LOCATION_ENTITY_ID=device_tracker.car
# SIRISAI_CAR_LOCK_ENTITY_ID=lock.car
# SIRISAI_CAR_CLIMATE_ENTITY_ID=climate.car
# SIRISAI_CAR_LOW_BATTERY_PERCENT=30

# Parcel tracking via 17TRACK.
# SIRISAI_SEVENTEENTRACK_API_KEY=
# SIRISAI_SEVENTEENTRACK_BASE_URL=https://api.17track.net
# SIRISAI_PARCEL_REFRESH_MINUTES=120

# Tool choice: rank tools by meaning (embeddings) as well as keywords, and
# how often the scheduled model-choice eval runs (0 = never).
# SIRISAI_TOOL_SELECTION_SEMANTIC=true
# SIRISAI_EVAL_INTERVAL_DAYS=7

# The learning loop. Each night SirisAI looks back over the day: what you
# undid or corrected, what didn't work, which suggestions you ignored. It
# turns corrections into eval cases, proposes facts to remember (you say yes
# or no in the attention feed), and asks before repeating an action you
# keep undoing. Once a week it reviews your goals. Local hours; blank = off.
# SIRISAI_REFLECTION_HOUR_LOCAL=3
# SIRISAI_GOAL_REVIEW_HOUR_LOCAL=8
# SIRISAI_GOAL_REVIEW_DAY=0

# The hub contract (/siris/hub/v1) SirisOS builds on: how often the attention
# feed refreshes habit suggestions, waiting jobs, queued notices and
# second-brain reviews in the background (0 = only when asked).
# SIRISAI_ATTENTION_SYNC_MINUTES=5
# SirisOS, the home screen: SirisAI uses its engineering library (standards,
# calculators, projects, SirisHydro), its app states, and Brad's career
# record (CPD from Engineers Australia, chartership steps). The key must match
# SIRISOS_SERVICE_KEY on the SirisOS side (openssl rand -hex 32).
# SIRISAI_SIRISOS_URL=http://192.168.0.100:8094
# SIRISAI_SIRISOS_SERVICE_KEY=

# Comma-separated tool names to allow running despite being RESTRICTED
# (see app/plugins/base.py's ToolPermission). Empty (default) = none.
# Nothing built-in is RESTRICTED yet -- this is scaffolding for the first
# tool destructive enough to need it.
SIRISAI_RESTRICTED_TOOLS_ENABLED=

# Required for any /siris/* route once this is reachable off localhost
# (e.g. behind Tailscale). Leave unset for local-only dev -- auth is off
# by default. Generate one with: openssl rand -hex 32
SIRISAI_API_KEY=
