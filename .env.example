SIRISAI_APP_NAME=SirisAI
SIRISAI_ENVIRONMENT=development
SIRISAI_LOG_LEVEL=INFO

SIRISAI_HOST=0.0.0.0
SIRISAI_PORT=8000

SIRISAI_DATABASE_URL=sqlite:///./data/sirisai.db

# Model-agnostic LLM settings.
SIRISAI_LLM_PROVIDER=none
SIRISAI_OLLAMA_BASE_URL=http://localhost:11434
SIRISAI_OLLAMA_MODEL=llama3

# Speech settings. "openai_compatible" works with any local server that
# speaks OpenAI's audio API shape (whisper.cpp server, speaches /
# faster-whisper-server for STT, openedai-speech for TTS, ...).
SIRISAI_STT_PROVIDER=none
SIRISAI_STT_BASE_URL=http://localhost:8081
SIRISAI_STT_MODEL=whisper-1

SIRISAI_TTS_PROVIDER=none
SIRISAI_TTS_BASE_URL=http://localhost:8082
SIRISAI_TTS_MODEL=tts-1
SIRISAI_TTS_VOICE=default

# Model router (app/llm/router.py): an optional second, faster/smaller
# model for short/simple prompts, alongside the default ("general") one
# configured above. Leave SIRISAI_FAST_LLM_PROVIDER=none to leave it off
# (the default -- every chat call uses the general model, same as before
# this existed). "off" policy always uses general even if a fast model is
# configured; "prompt_length" auto-routes prompts at or under the given
# character count to it. Either way, a chat request can force a role
# directly with "model_role": "fast".
SIRISAI_MODEL_ROUTER_POLICY=off
SIRISAI_MODEL_ROUTER_FAST_MAX_PROMPT_CHARS=120
SIRISAI_FAST_LLM_PROVIDER=none
SIRISAI_FAST_LLM_OLLAMA_BASE_URL=http://localhost:11434
SIRISAI_FAST_LLM_OLLAMA_MODEL=llama3.2:1b

# Home Assistant. Both must be set for the home_assistant_* tools to be
# registered -- leave either blank to leave them off. Create a long-lived
# access token in Home Assistant under your profile -> Security ->
# Long-Lived Access Tokens.
SIRISAI_HOME_ASSISTANT_BASE_URL=
SIRISAI_HOME_ASSISTANT_TOKEN=

# Cost/resource dashboard (milestone 47, GET /siris/metrics/dashboard):
# LLM token spend is always tracked once an LLM backend is configured
# above, no setting needed. Homelab power draw has no sensor of its own
# in this codebase, so it reads a Home Assistant entity's state as a
# wattage reading instead (e.g. a smart plug/PDU sensor) -- requires
# SIRISAI_HOME_ASSISTANT_BASE_URL/TOKEN above to also be set. Empty
# (default) = power draw isn't tracked.
SIRISAI_POWER_SENSOR_ENTITY_ID=

# System info tool (CPU/memory/disk/temperature) -- always on, no
# credentials needed. Comma-separated mount paths to report disk usage
# for; "/" alone reflects this container's own filesystem unless you've
# bind-mounted host paths in. Add more (e.g. "/,/mnt/nas") as needed.
SIRISAI_SYSTEM_INFO_DISK_PATHS=/

# Docker. Set to enable docker_list_containers/docker_restart_container.
# Point at a Unix socket -- mount the host's /var/run/docker.sock into
# this container read-write in docker-compose.yml -- or a TCP-exposed
# daemon (e.g. tcp://192.168.1.10:2375). Leave blank to leave these off.
SIRISAI_DOCKER_BASE_URL=

# Plex. Both must be set for the plex_* tools to be registered. Find your
# token at https://support.plex.tv/articles/204059436.
SIRISAI_PLEX_BASE_URL=http://localhost:32400
SIRISAI_PLEX_TOKEN=

# UniFi. Both must be set for the unifi_* tools to be registered. Uses
# UniFi's cloud Site Manager API -- generate a key at unifi.ui.com ->
# Settings -> API, and set SIRISAI_UNIFI_BASE_URL=https://api.ui.com
# (live-verified 2026-09; a local controller's own Integration API key
# didn't authenticate against this same controller, so that's the one
# confirmed to actually work). unifi_list_clients isn't available this
# way -- the cloud API doesn't expose live connected-client lists, only
# device status; that tool call errors clearly rather than doing nothing.
SIRISAI_UNIFI_BASE_URL=
SIRISAI_UNIFI_API_KEY=
SIRISAI_UNIFI_SITE=default
SIRISAI_UNIFI_VERIFY_SSL=true

# Weather, via Open-Meteo -- free, no API key. Both lat/long must be set
# for the weather_current tool to be registered.
SIRISAI_WEATHER_LATITUDE=
SIRISAI_WEATHER_LONGITUDE=

# Calendar via CalDAV -- works with Nextcloud, Radicale, Baikal, iCloud,
# etc. Set the URL to enable calendar_upcoming_events; username/password
# only if your server needs them (many self-hosted setups use an
# app-specific password rather than your real account password).
SIRISAI_CALDAV_URL=
SIRISAI_CALDAV_USERNAME=
SIRISAI_CALDAV_PASSWORD=

# Proactive notifications via ntfy.sh (https://ntfy.sh/docs/) -- no
# account needed, just a topic name (treat it like a secret: anyone who
# knows it can read your notifications on the public service, or
# self-host your own ntfy instance and point SIRISAI_NTFY_BASE_URL at
# it). Set the topic to enable the notify tool and let
# POST /siris/proactive/check actually send something when it finds a
# problem; leave it blank and that endpoint still runs the health check,
# it just never notifies. Example crontab entry to check every 15
# minutes: */15 * * * * curl -s -X POST -H "Authorization: Bearer
# $SIRISAI_API_KEY" http://localhost:8000/siris/proactive/check
SIRISAI_NTFY_BASE_URL=https://ntfy.sh
SIRISAI_NTFY_TOPIC=

# Actionable push notifications (milestone 43): the externally-reachable
# base URL this instance is served at (behind a reverse proxy, a
# Cloudflare tunnel, Tailscale, etc). Needed only to build the "Confirm"
# action button ntfy attaches when a routine's action needs confirmation
# -- the button has to point somewhere your phone can actually reach, not
# necessarily http://localhost:8000. Leave blank and those notifications
# still get sent, just without a one-tap action.
SIRISAI_PUBLIC_BASE_URL=

# Persona/voice consistency layer (milestone 45): a system message
# applied to every chat turn, ahead of context -- how SirisAI talks, not
# what it currently knows. Blank (default) = no persona message at all,
# just the raw model's own default tone. Uncomment and adjust to taste:
# SIRISAI_PERSONA=You are SirisAI, a self-hosted homelab assistant. Be concise and direct; dry wit is welcome, sycophancy is not. You have real tools and act on this user's actual infrastructure, so be precise about what you know versus what you're inferring.
SIRISAI_PERSONA=

# Hermes Agent -- a separate homelab agent running on this same host, with
# its own memories, skills, and terminal access, used here to delegate
# Docker container control and other system-level tasks it already knows
# how to do. Talks an OpenAI-style chat completions endpoint
# (POST {base_url}/v1/chat/completions). Leave the base_url blank to
# leave the hermes_run_task tool unregistered. Some Hermes deployments
# are unauthenticated -- leave hermes_api_key blank for those; others
# need `Authorization: Bearer <key>`, set it if yours 401s without one.
SIRISAI_HERMES_BASE_URL=
SIRISAI_HERMES_MODEL=hermes
SIRISAI_HERMES_API_KEY=

# Routines (app/routines/) -- no settings of their own, but like
# /siris/proactive/check above, POST /siris/routines/run_due needs an
# external trigger to actually run due routines; SirisAI only decides
# what's due when asked. Example crontab entry to check every 5 minutes
# (frequent enough to catch a routine with interval_minutes=5 or higher):
# */5 * * * * curl -s -X POST -H "Authorization: Bearer $SIRISAI_API_KEY"
# http://localhost:8000/siris/routines/run_due

# Comma-separated tool names to allow running despite being RESTRICTED
# (see app/plugins/base.py's ToolPermission). Empty (default) = none.
# Nothing built-in is RESTRICTED yet -- this is scaffolding for the first
# tool destructive enough to need it.
SIRISAI_RESTRICTED_TOOLS_ENABLED=

# Required for any /siris/* route once this is reachable off localhost
# (e.g. behind Tailscale). Leave unset for local-only dev -- auth is off
# by default. Generate one with: openssl rand -hex 32
SIRISAI_API_KEY=
