# The stack's own settings. ./setup.sh copies this to .env and fills in the
# secrets; edit the rest by hand. App settings live in sirisai.env and
# sirisos.env.

# Your server's address as you type it in a browser (IP or hostname).
SIRIS_HOST=192.168.0.100
TZ=Australia/Melbourne

# Host ports.
SIRISAI_PORT=8000
SIRISOS_PORT=8094

# Where your phone opens SirisAI from SirisOS's tiles (blank = not shown).
SIRISAI_PUBLIC_URL=http://192.168.0.100:8000

# Where the SirisOS source is checked out, relative to this folder.
SIRISOS_SRC=../../SirisOS

# Secrets -- setup.sh generates these. Keep this file private.
# SirisAI's API key (also what SirisOS uses to call it).
SIRISAI_API_KEY=
# The key SirisAI uses to read SirisOS's engineering library (read-only routes).
SIRIS_SERVICE_KEY=
# Signs SirisOS sessions.
SIRISOS_JWT_SECRET=
