+               lambda v: (lambda r: [_r("Minor headloss", f"{fixed(r['headloss'], 3)} m"), _r("Velocity", f"{fixed(r['velocity'], 2)} m/s")])(minor_loss(v["q"], v["d"], v["k"]))),
