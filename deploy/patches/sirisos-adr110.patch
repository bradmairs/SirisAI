+               lambda v: (lambda r: [*_flow(r["flow"], r["velocity"]), _r("Flow area", f"{fixed(r['area'], 3)} m²")])(trapezoidal_channel(v["b"], v["y"], v["z"], v["n"], v["s"]))),
